{
  "name": "uav-checklist",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm ci",
  "forwardPorts": [5173, 4173],
  "portsAttributes": {
    "5173": { "label": "Dev server", "onAutoForward": "openPreview" },
    "4173": { "label": "Preview (production build)" }
  },
  "customizations": {
    "vscode": { "extensions": ["svelte.svelte-vscode", "vitest.explorer"] }
  }
}
